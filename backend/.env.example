# Ambiente
APP_ENV=development
HOST=127.0.0.1
PORT=5000

# Banco
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=wepay_db


# JWT
SECRET_KEY=troque-por-uma-chave-segura-e-unica
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# Rate limit
RATE_LIMIT_STORAGE_URI=memory://
RATE_LIMIT_LOGIN=5 per minute
RATE_LIMIT_REGISTER=10 per hour
RATE_LIMIT_EMAIL_CONFIRM=10 per hour
RATE_LIMIT_EMAIL_RESEND=5 per hour

# CORS
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Email
EMAIL_REMETENTE=
EMAIL_SENHA_APP=
EMAIL_SERVER=smtp.gmail.com
EMAIL_PORT=465
# Use the URL of the web app reachable by recipients. In production, use HTTPS.
FRONTEND_URL=http://localhost:8081
# Confirmação obrigatória exige SMTP funcional. Use uma senha de app, nunca a senha normal da conta.
# O link abaixo abre a rota Expo `verificar-email`; configure também o esquema do app.
APP_DEEP_LINK_URL=wepay://
ALLOW_EMAIL_TEST=false
