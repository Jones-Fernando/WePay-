# Ambiente
APP_ENV=development
HOST=0.0.0.0
PORT=5000

# Banco
DB_HOST=localhost
DB_PORT=3306
DB_USER=wepay_runtime
DB_PASSWORD=
DB_NAME=wepay_db
DB_POOL_SIZE=5
# Em produção, configure o caminho do certificado CA do servidor MySQL.
DB_SSL_CA=


# JWT
# Gere uma chave exclusiva; produção exige pelo menos 32 caracteres aleatórios.
SECRET_KEY=troque-por-uma-chave-segura-e-unica
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30
# Web: cookie de refresh HttpOnly; use SameSite=None apenas com HTTPS e CORS restrito.
AUTH_REFRESH_COOKIE_NAME=wepay_refresh
AUTH_REFRESH_COOKIE_SAMESITE=Lax
AUTH_REFRESH_COOKIE_SECURE=false

# Rate limit
# Em produção, configure storage compartilhado (por exemplo, redis://host:6379/0).
RATE_LIMIT_STORAGE_URI=memory://
RATE_LIMIT_LOGIN=5 per minute
RATE_LIMIT_REGISTER=10 per hour
RATE_LIMIT_PASSWORD_RESET_REQUEST=5 per hour
RATE_LIMIT_PASSWORD_RESET_CONFIRM=10 per hour
RATE_LIMIT_REFRESH=10 per minute
RATE_LIMIT_RECEIPT_HOURLY=5 per hour
RATE_LIMIT_RECEIPT_DAILY=20 per day
# Por padrão, cabeçalhos X-Forwarded-For não são confiáveis.
# Configure somente se o backend aceitar conexões apenas do proxy listado.
TRUSTED_PROXY_HOPS=0
TRUSTED_PROXY_CIDRS=

# Métricas do Gemini: emite um alerta de log uma vez/modelo/dia ao atingir o limite.
GEMINI_DAILY_ALERT_REQUESTS=500
# Modelo de leitura e contingência para indisponibilidade temporária.
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# CORS
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Email
EMAIL_REMETENTE=
EMAIL_SENHA_APP=
EMAIL_SERVER=smtp.gmail.com
EMAIL_PORT=465
# Gere com Fernet.generate_key(); mantenha estável para descriptografar a fila pendente.
EMAIL_OUTBOX_ENCRYPTION_KEY=
# Use the URL of the web app reachable by recipients. Production requires HTTPS.
FRONTEND_URL=http://localhost:8081
# Expo Go em desenvolvimento: exp://HOST:8081/--/redefinir-senha
# Em produção, use HTTPS ou wepay://redefinir-senha para o app instalado.
# Vazio mantém o link web baseado em FRONTEND_URL.
PASSWORD_RESET_URL=
# Use a senha de app, nunca a senha normal da conta.
ALLOW_EMAIL_TEST=false

# Configure somente se o projeto Expo exigir autenticação no serviço de push.
EXPO_ACCESS_TOKEN=
