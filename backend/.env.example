# Ambiente
APP_ENV=development
HOST=127.0.0.1
PORT=5000

# Banco
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=wepay_db
DB_POOL_SIZE=5


# JWT
# Gere uma chave exclusiva; produção exige pelo menos 32 caracteres aleatórios.
SECRET_KEY=troque-por-uma-chave-segura-e-unica
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30
# Web: cookie de refresh HttpOnly; use SameSite=None apenas com HTTPS e CORS restrito.
AUTH_REFRESH_COOKIE_NAME=wepay_refresh
AUTH_REFRESH_COOKIE_SAMESITE=Lax
AUTH_REFRESH_COOKIE_SECURE=false

# Rate limit
# Em produção, configure storage compartilhado (por exemplo, redis://host:6379/0).
RATE_LIMIT_STORAGE_URI=memory://
RATE_LIMIT_LOGIN=5 per minute
RATE_LIMIT_REGISTER=10 per hour
RATE_LIMIT_PASSWORD_RESET_REQUEST=5 per hour
RATE_LIMIT_PASSWORD_RESET_CONFIRM=10 per hour

# CORS
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Email
EMAIL_REMETENTE=
EMAIL_SENHA_APP=
EMAIL_SERVER=smtp.gmail.com
EMAIL_PORT=465
# Use the URL of the web app reachable by recipients. Production requires HTTPS.
FRONTEND_URL=http://localhost:8081
# Use a senha de app, nunca a senha normal da conta.
ALLOW_EMAIL_TEST=false

# Configure somente se o projeto Expo exigir autenticação no serviço de push.
EXPO_ACCESS_TOKEN=
