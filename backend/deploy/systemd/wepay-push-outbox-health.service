[Unit]
Description=Check WePay push outbox health
OnFailure=wepay-push-outbox-alert@%n.service

[Service]
Type=oneshot
User=wepay
Group=wepay
WorkingDirectory=/opt/wepay/backend
Environment=APP_ENV=production
Environment=PUSH_WORKER_HEARTBEAT_FILE=/run/wepay/push-worker.heartbeat
ExecStart=/opt/wepay/backend/.venv/bin/python -m services.push_outbox_worker --health-check --max-pending-count 100 --max-pending-age-seconds 300 --max-failed-count 0 --heartbeat-max-age-seconds 15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
