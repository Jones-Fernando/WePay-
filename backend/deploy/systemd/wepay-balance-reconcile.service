[Unit]
Description=Check WePay materialized balances
After=network-online.target
Wants=network-online.target
OnFailure=wepay-balance-reconcile-alert@%n.service

[Service]
Type=oneshot
User=wepay
Group=wepay
WorkingDirectory=/opt/wepay/backend
Environment=APP_ENV=production
ExecStart=/opt/wepay/backend/.venv/bin/flask --app app reconcile-balances --check-only
TimeoutStartSec=30min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
