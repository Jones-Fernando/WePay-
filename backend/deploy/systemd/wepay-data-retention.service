[Unit]
Description=Clean up retained WePay data
After=network-online.target
Wants=network-online.target
OnFailure=wepay-data-retention-alert@%n.service

[Service]
Type=oneshot
User=wepay
Group=wepay
WorkingDirectory=/opt/wepay/backend
Environment=APP_ENV=production
ExecStart=/opt/wepay/backend/.venv/bin/flask --app app cleanup-retained-data --batch-size 500
TimeoutStartSec=15min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
